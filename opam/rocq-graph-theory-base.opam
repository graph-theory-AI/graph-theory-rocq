opam-version: "2.0"
synopsis: "Public graph-theory primitives for Rocq and MathComp"
description: """
The GTBase public graph library. Builds and installs only public modules;
conjectures, migration certificates and examples are not installed.
This package is developed and validated with the pinned Rocq 9.1.1 toolchain.
Building requires Python >= 3.9 (tested with 3.12.3); conf-python-3 only checks
that python3 is present.
"""
maintainer: "Marc Lelarge <marc.lelarge@gmail.com>"
authors: [ "Marc Lelarge" ]
license: "Apache-2.0"
homepage: "https://github.com/graph-theory-AI/graph-theory-rocq"
bug-reports: "https://github.com/graph-theory-AI/graph-theory-rocq/issues"
dev-repo: "git+https://github.com/graph-theory-AI/graph-theory-rocq.git"
depends: [
  "rocq-core" {= "9.1.1"}
  "coq-graph-theory" {= "0.9.7"}
  "rocq-mathcomp-algebra" {= "2.5.0"}
  "rocq-hierarchy-builder" {= "1.10.3"}
  "conf-python-3" {build}
]
build: [
  ["python3" "-c" "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 'rocq-graph-theory packaging needs Python >= 3.9 at build time')"]
  ["python3" "-B" "meta/library_package.py" "base"]
  ["sh" "-c" "cd _build/library/base && rocq makefile -f _CoqProject -o Makefile.coq"]
  [make "-C" "_build/library/base" "-f" "Makefile.coq" "-j%{jobs}%"]
]
