  "Digraph.foundations.degree_balance": {
   "path": "digraph-theory/theories/foundations/degree_balance.v",
   "overrides": {
    "indeg": {
     "verdict": "FAITHFUL",
     "note": "indeg v: the number of in-neighbours #|[set u | u --> v]|, the companion of outdeg; a loop counts once; swaps with outdeg on the converse digraph."
    },
    "balanced": {
     "verdict": "FAITHFUL",
     "note": "balanced D: every vertex has equal in- and out-degree; no connectivity, looplessness, inhabitance or tour premise; invariant under converse; holds on the empty, arcless and loop digraphs and on disconnected unions of balanced digraphs."
    },
    "balancedb": {
     "verdict": "FAITHFUL",
     "note": "balancedb D: the Boolean [forall v, indeg v == outdeg v], reflected to balanced by balancedP."
    }
   },
   "machine_evidence": [
    "balancedP",
