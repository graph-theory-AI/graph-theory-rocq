   "overrides": {
    "eulerian": {
     "verdict": "FAITHFUL",
     "note": "eulerian G: connected over all vertices (uwalk, orientation-free) with every arc-end degree even (a loop counts two); no nonempty, loopless, simple, minimum-degree or tour premise; the empty multigraph and an isolated vertex qualify, a single edge and any disconnected carrier do not."
    },
    "even_degrees": {
     "verdict": "FAITHFUL",
     "note": "even_degrees G: every vertex has even multigraph degree mdeg (arc ends)."
    },
    "even_degreesb": {
     "verdict": "FAITHFUL",
     "note": "even_degreesb G: the Boolean [forall v, ~~ odd (mdeg v)], reflected to even_degrees by even_degreesP; connectivity keeps its Prop form (no Boolean mconnected exists)."
    }
