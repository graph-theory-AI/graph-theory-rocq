{
 "schema_version": 1,
 "family": "cycle-edges",
 "modules": {
  "GTBase.walks_paths": {
   "path": "base/theories/walks_paths.v",
   "overrides": {
    "seq_cycle_edge_list": {
     "verdict": "FAITHFUL",
     "note": "seq_cycle_edge_list c: the ordered list of the unordered pairs [set c_i; c_(i+1)] of cyclically successive entries, one per position, the closing pair (last, first) included; repetitions and order kept; no adjacency, uniqueness or length premise."
    },
    "seq_cycle_edge_set": {
     "verdict": "FAITHFUL",
     "note": "seq_cycle_edge_set c: the finite support of seq_cycle_edge_list c, i.e. the pairs [set u; v] of cyclically consecutive entries; keeps non-edges and one-vertex sets; invariant under rotation and reversal."
    },
    "seq_cycle_graph_edge_set": {
     "verdict": "FAITHFUL",
     "note": "seq_cycle_graph_edge_set c: the actual edges [set x; y] (x -- y) between cyclically consecutive entries of c; equal to seq_cycle_edge_set c :&: E(G) for every c."
    },
    "seq_next_edge_set": {
     "verdict": "FAITHFUL",
     "note": "seq_next_edge_set c: the sets [set x; next c x] for x in c, next reading the first occurrence; contained in the support, equal to it when c is duplicate-free (uniq c), different on repeated entries."
    }
   },
   "machine_evidence": [
