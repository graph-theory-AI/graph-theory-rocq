    "GTBase.bag_decompositions": {
      "path": "base/theories/bag_decompositions.v",
      "overrides": {
        "bag_decomposition": {
          "verdict": "FAITHFUL",
          "note": "Exactly vertex coverage, edge coverage and connected fibres for supplied G,T,bag, with arbitrary index and no extra guard. Same-forest upstream sdecomp equivalence is explicit."
        },
        "tree_bag_decomposition": {
          "verdict": "FAITHFUL",
          "note": "Explicit conjunction is_tree [set:T] and raw bag contract; is_tree itself allows empty index. Matches X169 without repairing its unrelated token-path defect."
